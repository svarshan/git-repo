{
  "name": "moolva-griby",
  "version": "3.5.0",
  "description": "MoOLVa Грибы 3.5 — офлайн-карта и навигатор Нижегородской области",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "ru.moolva.griby",
    "productName": "MoOLVa Грибы",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "catalog.js",
      "photos.js",
      "app.js",
      "main.cjs",
      "media/photos/**/*",
      "package.json",
      "build/moolva-griby.ico",
      "core20.js",
      "upgrade20.js",
      "upgrade20.css",
      "region20.js",
      "photos-gallery20.js",
      "media/gallery/**/*",
      "community30.js",
      "expedition30.js",
      "expedition30.css",
      "google31.js",
      "google31.css",
      "free-map32.js",
      "free-map32.css",
      "node_modules/leaflet/dist/**/*",
      "offline-map-file.cjs",
      "offline-localities.js",
      "node_modules/protomaps-leaflet/dist/protomaps-leaflet.js",
      "map-packs.cjs",
      "map-regions.json",
      "preload.cjs",
      "personal34.js"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/moolva-griby.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "MoOLVa-Griby-3.5-Setup-${arch}.exe"
    },
    "portable": {
      "artifactName": "MoOLVa-Griby-3.5-Full-Portable-${arch}.exe"
    },
    "extraResources": [
      {
        "from": "maps/nizhny-novgorod.pmtiles",
        "to": "maps/nizhny-novgorod.pmtiles"
      }
    ],
    "electronLanguages": [
      "ru",
      "en-US"
    ]
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "protomaps-leaflet": "5.1.0"
  }
}
