{
  "name": "moolva-griby",
  "version": "1.0.0",
  "description": "MoOLVa Griby PRO MAX — educational offline fungus atlas of central Russia",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "ru.moolva.griby",
    "productName": "MoOLVa Грибы",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "catalog.js",
      "photos.js",
      "app.js",
      "main.cjs",
      "media/photos/**/*",
      "package.json",
      "build/moolva-griby.ico"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/moolva-griby.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "MoOLVa-Griby-1.0-Setup-${arch}.exe"
    },
    "portable": {
      "artifactName": "MoOLVa-Griby-1.0-Portable-${arch}.exe"
    }
  }
}
