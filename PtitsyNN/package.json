{
  "name": "ptitsy-nizhny-novgorod",
  "version": "7.5.0",
  "private": true,
  "description": "MoOLVa 7.5 Field PRO MAX: real Perch v2 12/24 windows, Atlas ULTRA 3.0 nearby observations, 250 licensed audio target, academy and legacy-safe journal.",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.moolva.ptitsynn",
    "productName": "Птицы Нижегородской области",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*",
      "package.json",
      "data/coverage.json",
      "data/audio-audit.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "artifactName": "MoOLVa-7.5-Setup-${arch}.exe"
    },
    "portable": {
      "artifactName": "MoOLVa-7.5-Portable-${arch}.exe"
    },
    "publish": null,
    "asarUnpack": [
      "app/models/**/*",
      "node_modules/onnxruntime-node/**/*"
    ]
  },
  "dependencies": {
    "onnxruntime-node": "1.24.3"
  }
}
